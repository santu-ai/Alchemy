# 复制为 .env.local 后填写。只填你需要的那几项，没填的服务会显示为「未配置」。
# 修改后需要重启 pnpm dev 才会生效。

# Ollama 地址，默认就是本机，一般不用改
OLLAMA_HOST=http://127.0.0.1:11434

# DeepSeek  https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 通义千问（阿里云百炼）  https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=

# OpenAI  https://platform.openai.com
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic  https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenRouter：一个 Key 调用几百个模型  https://openrouter.ai
OPENROUTER_API_KEY=

# 任意 OpenAI 兼容接口，例如 Moonshot、智谱、硅基流动或自建的 vLLM
# CUSTOM_OPENAI_NAME=硅基流动
# CUSTOM_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# CUSTOM_OPENAI_API_KEY=

# 可选：只显示指定的模型（逗号分隔）。不填则自动从服务商拉取模型列表。
# DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner
# OPENROUTER_MODELS=

# ——— Agent 工作台 ———
# 允许派任务的仓库（逗号分隔），当前项目总是在内。只放信得过的仓库：
# Junie 无头运行会自动信任项目，并加载项目里的 MCP 和 hooks。
# ALCHEMY_REPOS=~/WebstormProjects/another-repo
# 任务记录和工作树放在这里，默认 ~/.alchemy
# ALCHEMY_HOME=
# 命令行位置，一般能自动找到
# CURSOR_AGENT_BIN=
# JUNIE_BIN=
# 不想用交互登录时可以直接给 Key
# CURSOR_API_KEY=
# JUNIE_API_KEY=
